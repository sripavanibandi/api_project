<?xml version="1.0" encoding="UTF-8"?>

<xs:schema
        xmlns:xs="http://www.w3.org/2001/XMLSchema"
        targetNamespace="http://example.com/invoice"
        xmlns:tns="http://example.com/invoice"
        elementFormDefault="qualified">

    <xs:element name="generateInvoiceRequest">

        <xs:complexType>

            <xs:sequence>

                <xs:element
                        name="orderId"
                        type="xs:long"/>

                <xs:element
                        name="totalAmount"
                        type="xs:double"/>

            </xs:sequence>

        </xs:complexType>

    </xs:element>


    <xs:element name="generateInvoiceResponse">

        <xs:complexType>

            <xs:sequence>

                <xs:element
                        name="invoiceId"
                        type="xs:string"/>

                <xs:element
                        name="totalAmount"
                        type="xs:double"/>

            </xs:sequence>

        </xs:complexType>

    </xs:element>

</xs:schema>